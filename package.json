{
  "name": "janus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k 'pnpm dev:server' 'pnpm dev:web'",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "dev:actors": "pnpm dlx bun@1.4.4 server/runtime/actor/dev.ts"
  },
  "dependencies": {
    "@agent-relay/sdk": "15.0.1",
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/openai": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.80.0",
    "deepagents": "1.16.2",
    "express": "^5.0.0",
    "freestyle": "0.2.21",
    "langchain": "1.6.0",
    "langsmith": "^0.9.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "terse-sdk": "0.14.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
